            android:exported="false" />
        <activity
            android:name=".settings.HookAppsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.HookAppDetailActivity"
            android:exported="false" />
        <activity
            android:name=".settings.AlphaActivity"
            android:exported="false" />
        <activity
            android:name=".settings.RestartScopeActivity"
            android:exported="false" />
    </application>
</manifest>
